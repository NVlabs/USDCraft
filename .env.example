# Copy this file to `.env` in the repository root and fill in what your arm needs. `.env` is
# ignored by git; keep it private and never commit it. USDCraft reads only the settings listed
# here; any other name in `.env` is ignored.

# Required for the Provider arm only (`usdcraft generation`, `usdcraft reconstruction` and their
# batch forms): your OpenAI API key. The Codex arm does not use it.
OPENAI_API_KEY=

# Optional. Defaults shown. `--model` / `--reasoning` on the command line override the model and
# the reasoning effort (default `low`) for one run. OPENAI_BASE_URL may point at any
# OpenAI-compatible endpoint (for example a proxy).
# OPENAI_MODEL=gpt-6-astra
# OPENAI_BASE_URL=https://api.openai.com/v1

# Alternative endpoint: the NVIDIA inference API. Set NVIDIA_API_KEY and leave OPENAI_API_KEY
# unset (when both are set, OPENAI_API_KEY is used). Defaults shown.
# NVIDIA_API_KEY=
# NVIDIA_MODEL=azure/openai/gpt-6-astra
# NVIDIA_BASE_URL=https://inference-api.nvidia.com/v1

# Maximum size in bytes of one request to the model (the run's full conversation is sent each turn).
USDCRAFT_MAX_REQUEST_BYTES=67108864

# Optional, both arms. Seconds allowed for compiling one generated model.py in its worker process
# before the compile is abandoned (the Author is told and repairs; the run itself has no time
# limit).
USDCRAFT_COMPILE_TIMEOUT_SECONDS=300

# Optional, Codex arm only (`generation-codex`, `reconstruction-codex` and their batch forms): path
# to the `codex` executable when it is not on PATH.
# USDCRAFT_CODEX_BIN=/path/to/codex
